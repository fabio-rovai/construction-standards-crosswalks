    sssom:object_label "IfcPile" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id uniclass:Ss_20_05_65 ;
    sssom:subject_label "Piling systems" .

<https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc/mapping/015> a sssom:Mapping ;
    rdfs:comment "The least losable and least clean row in the set: IFC4 has no frame entity, and an IfcElementAssembly instance can represent an assembled frame. Related only - most exchanged models represent frames as loose beams and columns with no assembly object at all." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.55 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc> ;
    sssom:object_id ifc:IfcElementAssembly ;
    sssom:object_label "IfcElementAssembly" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id uniclass:Ss_20_10 ;
    sssom:subject_label "Structural frame systems" .

<https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc/mapping/016> a sssom:Mapping ;
    rdfs:comment "System-stratum counterpart of the floors row, with the same crossed-scope caveats." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.55 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc> ;
    sssom:object_id ifc:IfcSlab ;
    sssom:object_label "IfcSlab" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id uniclass:Ss_30 ;
    sssom:subject_label "Roof, floor and paving systems" .

<https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc/mapping/017> a sssom:Mapping ;
    rdfs:comment "System-stratum counterpart of the ceilings row." ;
