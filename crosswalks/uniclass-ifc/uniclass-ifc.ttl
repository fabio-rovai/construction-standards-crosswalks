<https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc/mapping/014> a sssom:Mapping ;
    rdfs:comment "System-stratum counterpart of the pile row: a piling system is the assembled set of piles plus caps and works, of which IfcPile occurrences are members." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.65 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/construction-crosswalks/uniclass-ifc> ;
